# Generated by `prrules init-workflow`. Edit freely.
#
# Runs prrules on a schedule. Each run fetches only PRs updated since the
# last one, extracts rules from new discussions, folds them into the existing
# rules, and opens (or updates) a pull request when the rules change.
#
# Required secrets:
#   ANTHROPIC_API_KEY     Claude API key.
#   PRRULES_GITHUB_TOKEN  Optional. A token that can read the mined repos;
#                         needed when they are not this repository.
#
# Incremental state lives in .prrules and is carried between runs with the
# Actions cache. A daily schedule keeps it from expiring (unused caches are
# evicted after 7 days). If it is ever lost, the next run starts over, and
# --max-cost stops it before it spends more than you allow.
name: prrules

on:
  schedule:
    - cron: "[[.Cron]]"
  workflow_dispatch:

concurrency:
  group: prrules
  cancel-in-progress: false

permissions:
  contents: write
  pull-requests: write

jobs:
  rules:
    runs-on: ubuntu-latest
    timeout-minutes: 300
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: stable
          cache: false

      - name: Install prrules
        run: go install github.com/an4eetos/pr_reviews_to_skills/cmd/prrules@[[.Version]]

      - name: Restore prrules state
        uses: actions/cache/restore@v4
        with:
          path: .prrules
          key: prrules-${{ github.run_id }}
          restore-keys: prrules-

      - name: Mine PR reviews
        env:
          GITHUB_TOKEN: ${{ secrets.PRRULES_GITHUB_TOKEN || github.token }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: >-
          prrules run --yes
[[- range .Repos]]
          --repo [[.]]
[[- end]]
[[- if .Combined]]
          --combined
[[- end]]
[[- if .Multi]]
          --out-dir [[.ExportDir]]
[[- end]]
          --max-wait [[.MaxWait]]
          --max-cost [[.MaxCost]]
          --export [[.Export]]
          --export-dir [[.ExportDir]]

      # Saved even when the run fails or times out, so submitted batches and
      # fetch progress carry over to the next run.
      - name: Save prrules state
        if: always()
        uses: actions/cache/save@v4
        with:
          path: .prrules
          key: prrules-${{ github.run_id }}

      - name: Open a pull request with the updated rules
        uses: peter-evans/create-pull-request@v7
        with:
          branch: prrules/update
          delete-branch: true
          title: Update review rules mined from PR discussions
          commit-message: Update review rules mined by prrules
          body: |
            prrules found new or changed review rules in recent pull-request discussions.
            Each rule cites the review comments behind it; check the evidence before merging.
          add-paths: |
[[- range .Paths]]
            [[.]]
[[- end]]
